# ============================================================
# AI RAG Interviewer — Environment Configuration
# ============================================================
# Copy this file to .env and fill in your actual values:
#   cp .env.example .env
#
# ⚠️  NEVER commit the .env file to git!
# ============================================================

# ---------- LLM Provider ----------
# Options: "groq" (free, recommended) or "gemini"
LLM_PROVIDER=groq

# ---------- Groq (Primary — Free Tier) ----------
# Get your key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# ---------- Gemini (Fallback + Embeddings) ----------
# Get your key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash
EMBEDDING_MODEL=text-embedding-004

# ---------- Database ----------
DATABASE_URL=sqlite:///./backend/interview.db

# ---------- ChromaDB (Vector Store) ----------
CHROMA_PATH=./backend/chroma_db

# ---------- Knowledge Base ----------
KNOWLEDGE_BASE_PATH=./knowledge

# ---------- JWT Authentication ----------
# Generate a strong secret: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=change-this-to-a-strong-random-secret

# ---------- CORS (Frontend Origins) ----------
# For local dev: http://localhost:3000
# For production: https://your-app.vercel.app
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
